{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sandbox.dev/schema/protocol-v1.schema.json",
  "title": "Agent Sandbox Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/clientMessage" },
    { "$ref": "#/$defs/serverMessage" }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wallTimeMs": { "type": "integer", "minimum": 1 },
        "cpuTimeMs": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "processes": { "type": "integer", "minimum": 1 },
        "outputBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "sandboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "backend": { "enum": ["auto", "native"], "default": "auto" },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mounts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "source", "access"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "source": { "type": "string", "minLength": 1 },
                  "access": { "enum": ["read-only", "read-write"] }
                }
              }
            },
            "protectedRoots": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "tempBytes": { "type": "integer", "minimum": 1 },
            "lease": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "enum": ["ephemeral", "persistent"], "default": "ephemeral" }
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["deny", "host"], "default": "deny" } }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inherit": {
              "type": "array",
              "maxItems": 128,
              "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "uniqueItems": true
            },
            "allowSet": {
              "type": "array",
              "maxItems": 128,
              "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "uniqueItems": true
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executables": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "path", "sha256"],
                "properties": {
                  "alias": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "limits": { "$ref": "#/$defs/resourceLimits" }
      }
    },
    "logicalPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount", "path"],
      "properties": {
        "mount": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string" }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "program"],
          "properties": {
            "kind": { "const": "exec" },
            "program": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "script"],
          "properties": {
            "kind": { "const": "shell" },
            "shell": { "const": "default" },
            "script": { "type": "string", "minLength": 1, "maxLength": 1048576 }
          }
        }
      ]
    },
    "capabilityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "backend", "status", "features", "reasons"],
      "properties": {
        "platform": { "type": "string" },
        "backend": { "type": "string" },
        "status": { "enum": ["enforced", "limited", "unavailable", "bypassed"] },
        "features": {
          "type": "object",
          "additionalProperties": { "enum": ["enforced", "limited", "unavailable"] }
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "protocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "message", "details"],
      "properties": {
        "code": { "type": "string" },
        "category": {
          "enum": ["protocol", "policy_violation", "capability", "resource", "process", "internal"]
        },
        "retryable": { "type": "boolean" },
        "message": { "type": "string" },
        "details": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "clientMessage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "client", "nonce"],
          "properties": {
            "type": { "const": "hello" },
            "protocol": { "$ref": "#/$defs/protocolVersion" },
            "client": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "$ref": "#/$defs/identifier" },
                "version": { "$ref": "#/$defs/identifier" }
              }
            },
            "nonce": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId"],
          "properties": {
            "type": { "const": "probe" },
            "requestId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "tenantId", "profile", "authorizationId", "policy"],
          "properties": {
            "type": { "const": "createSandbox" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "tenantId": { "$ref": "#/$defs/identifier" },
            "profile": { "$ref": "#/$defs/identifier" },
            "authorizationId": { "$ref": "#/$defs/identifier" },
            "policy": { "$ref": "#/$defs/sandboxPolicy" },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subject": { "type": "string" },
                "subjectId": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "sandboxId", "executionId", "command", "cwd"],
          "properties": {
            "type": { "const": "spawn" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "sandboxId": { "$ref": "#/$defs/identifier" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "command": { "$ref": "#/$defs/command" },
            "cwd": { "$ref": "#/$defs/logicalPath" },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "stdin": { "enum": ["pipe", "closed"] },
            "limits": { "$ref": "#/$defs/resourceLimits" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId", "sequence", "base64"],
          "properties": {
            "type": { "const": "stdin" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "sequence": { "type": "integer", "minimum": 1 },
            "base64": { "type": "string", "contentEncoding": "base64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId"],
          "properties": {
            "type": { "enum": ["closeStdin"] },
            "executionId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId", "signal"],
          "properties": {
            "type": { "const": "signal" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "signal": { "enum": ["terminate", "kill"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "sandboxId"],
          "properties": {
            "type": { "const": "closeSandbox" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "sandboxId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "tenantId", "authorizationId"],
          "properties": {
            "type": { "const": "revokeAuthorization" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "tenantId": { "$ref": "#/$defs/identifier" },
            "authorizationId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId"],
          "properties": {
            "type": { "const": "shutdown" },
            "requestId": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "serverMessage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "runtimeVersion", "platform", "features", "nonce"],
          "properties": {
            "type": { "const": "helloAck" },
            "protocol": { "$ref": "#/$defs/protocolVersion" },
            "runtimeVersion": { "type": "string" },
            "platform": { "type": "string" },
            "features": { "type": "array", "items": { "type": "string" } },
            "nonce": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "report"],
          "properties": {
            "type": { "const": "probeResult" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "report": { "$ref": "#/$defs/capabilityReport" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "sandboxId", "status", "mounts", "policyFingerprint", "capabilities"],
          "properties": {
            "type": { "const": "sandboxCreated" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "sandboxId": { "$ref": "#/$defs/identifier" },
            "status": { "enum": ["enforced", "limited", "unavailable", "bypassed"] },
            "mounts": { "type": "object", "additionalProperties": { "type": "string" } },
            "policyFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "capabilities": { "$ref": "#/$defs/capabilityReport" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "executionId", "position"],
          "properties": {
            "type": { "const": "queued" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "position": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId", "status"],
          "properties": {
            "type": { "const": "started" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "status": { "enum": ["enforced", "limited", "unavailable", "bypassed"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId", "stream", "sequence", "base64"],
          "properties": {
            "type": { "const": "output" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "stream": { "enum": ["stdout", "stderr"] },
            "sequence": { "type": "integer", "minimum": 1 },
            "base64": { "type": "string", "contentEncoding": "base64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "executionId", "code", "signal", "usage"],
          "properties": {
            "type": { "const": "exit" },
            "executionId": { "$ref": "#/$defs/identifier" },
            "code": { "type": ["integer", "null"] },
            "signal": { "type": ["string", "null"] },
            "usage": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "sandboxId"],
          "properties": {
            "type": { "const": "sandboxClosed" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "sandboxId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "authorizationId"],
          "properties": {
            "type": { "const": "authorizationRevoked" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "authorizationId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId"],
          "properties": {
            "type": { "const": "shutdownAck" },
            "requestId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestId", "executionId", "error"],
          "properties": {
            "type": { "const": "error" },
            "requestId": { "type": ["string", "null"] },
            "executionId": { "type": ["string", "null"] },
            "error": { "$ref": "#/$defs/protocolError" }
          }
        }
      ]
    }
  }
}
